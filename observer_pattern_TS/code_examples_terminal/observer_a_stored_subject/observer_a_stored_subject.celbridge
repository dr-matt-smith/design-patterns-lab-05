[celbridge]
celbridge-version = "1.4.0"
project-version = "0.1.0"

# 'hide' keeps resources out of the Explorer tree. 'search-exclude' also keeps them out of search.
# Both take glob patterns, e.g. "Python/.venv/**".
[celbridge.resources]
hide = [".gitignore", ".DS_Store", "Thumbs.db", "desktop.ini", "deno.lock"]
search-exclude = ["node_modules", "tools/story-builder/**"]

[[shortcut]]
resource = "terminal.console"
icon = "bs-terminal"
area = "bottom"
open-on-load = true

[[shortcut]]
resource = "README.md"
icon = "bs-book"
open-on-load = true

[[shortcut]]
resource = "class_diagram.story"
icon = "bs-easel"

[[shortcut]]
resource = "uml_revision.story"
icon = "bs-journal-text"
