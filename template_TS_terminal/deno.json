{
  "tasks": {
    "start": "deno run src/main.ts",
    "test": "deno test",
    "check": "deno check src/ tests/",
    "lint": "deno lint src/ tests/"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "compilerOptions": {
    "noImplicitOverride": true
  },
  "fmt": {
    "lineWidth": 120
  },
  "exclude": [".celbridge/", "tools/"]
}
